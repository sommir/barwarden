+<!-- Official Settings overlay source; generated. -->
+<popup-page [loading]="formLoading">
+  <popup-header slot="header" [pageTitle]="'appearance' | i18n" showBackButton>
+    <ng-container slot="end">
+      <app-pop-out></app-pop-out>
+    </ng-container>
+  </popup-header>
+
+  <form [formGroup]="appearanceForm">
+    <section class="macos-preference-group" aria-labelledby="appearance-interface">
+      <h2 id="appearance-interface" class="settings-group__title">{{ "appearance" | i18n }}</h2>
+      <bit-form-field class="macos-preference-row" disableMargin>
+        <bit-label class="macos-preference-row__copy">{{ "theme" | i18n }}</bit-label>
+        <bit-select class="macos-control-visible" formControlName="theme">
+          @for (o of themeOptions; track o.value) {
+            <bit-option [value]="o.value" [label]="o.name"></bit-option>
+          }
+        </bit-select>
+      </bit-form-field>
+    </section>
+
+    <section class="macos-preference-group" aria-labelledby="appearance-behavior">
+      <h2 id="appearance-behavior" class="settings-group__title">{{ "general" | i18n }}</h2>
+      <div class="macos-preference-row">
+        <span id="appearance-compact-label" class="macos-preference-row__copy">{{ "compactMode" | i18n }}</span>
+        <button
+          type="button"
+          class="macos-switch-owner macos-hit-target"
+          role="switch"
+          data-setting="compactMode"
+          aria-labelledby="appearance-compact-label"
+          [attr.aria-checked]="appearanceForm.controls.enableCompactMode.value"
+          (click)="appearanceForm.controls.enableCompactMode.setValue(!appearanceForm.controls.enableCompactMode.value)"
+        ><span aria-hidden="true"></span></button>
+      </div>
+      <div class="macos-preference-row">
+        <span id="appearance-animations-label" class="macos-preference-row__copy">{{ "showAnimations" | i18n }}</span>
+        <button
+          type="button"
+          class="macos-switch-owner macos-hit-target"
+          role="switch"
+          data-setting="animations"
+          aria-labelledby="appearance-animations-label"
+          [attr.aria-checked]="appearanceForm.controls.enableAnimations.value"
+          (click)="appearanceForm.controls.enableAnimations.setValue(!appearanceForm.controls.enableAnimations.value)"
+        ><span aria-hidden="true"></span></button>
+      </div>
+    </section>
+
+    <section class="macos-preference-group" aria-labelledby="appearance-vault">
+      <h2 id="appearance-vault" class="settings-group__title">{{ "vaultCustomization" | i18n }}</h2>
+      <div class="macos-preference-row">
+        <span id="appearance-favicons-label" class="macos-preference-row__copy">{{ "showIconsChangePasswordUrls" | i18n }}</span>
+        <button
+          type="button"
+          class="macos-switch-owner macos-hit-target"
+          role="switch"
+          data-setting="showFavicons"
+          aria-labelledby="appearance-favicons-label"
+          [attr.aria-checked]="appearanceForm.controls.enableFavicon.value"
+          (click)="appearanceForm.controls.enableFavicon.setValue(!appearanceForm.controls.enableFavicon.value)"
+        ><span aria-hidden="true"></span></button>
+      </div>
+      <div class="macos-preference-row">
+        <span id="appearance-quick-actions-label" class="macos-preference-row__copy">{{ "showQuickCopyActions" | i18n }}</span>
+        <button
+          type="button"
+          class="macos-switch-owner macos-hit-target"
+          role="switch"
+          data-setting="showQuickCopyActions"
+          aria-labelledby="appearance-quick-actions-label"
+          [attr.aria-checked]="appearanceForm.controls.showQuickCopyActions.value"
+          (click)="appearanceForm.controls.showQuickCopyActions.setValue(!appearanceForm.controls.showQuickCopyActions.value)"
+        ><span aria-hidden="true"></span></button>
+      </div>
+    </section>
+  </form>
 </popup-page>
