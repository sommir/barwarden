  "substitutions": [
    "official login strategy and two-factor services -> OfficialChallengeAdapter",
    "official browser dialog service -> shared AppBottomSheetComponent",
    "anonymous layout data service -> retained anonymous-shell title inputs",
    "pinned InputVerbatim OnInit attribute application -> the same application in OnInit and AfterViewInit so current bitInput host bindings cannot overwrite it",
    "pinned AutofocusDirective -> direct retained JslibModule export for source-direct Vault search",
    "unsupported-only provider state -> fixed unsupported message and back action without unavailable provider inputs or authentication controls",
    "successful verification keeps the submitted token stable until route takeover; failure and destruction clear it"
  ],
