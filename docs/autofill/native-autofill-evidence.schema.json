{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://barwarden.example/schemas/native-autofill-evidence.schema.json",
  "title": "Barwarden native AutoFill release evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "productVersion",
    "teamId",
    "osVersion",
    "lowerOsRuntime",
    "productionPromoted",
    "artifactHashes",
    "codes",
    "liveMatrix"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "status": { "enum": ["PASS", "BLOCKED"] },
    "productVersion": { "const": "0.1.2" },
    "teamId": { "const": "K7LY92JY96" },
    "osVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){1,2}$" },
    "lowerOsRuntime": { "const": "NATIVE_AUTOFILL_LOWER_OS_RUNTIME_UNVERIFIED" },
    "productionPromoted": { "type": "boolean" },
    "artifactHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["appSha256", "dmgSha256"],
      "properties": {
        "appSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "dmgSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fixedCode" }
    },
    "liveMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freshInstallCurrent",
        "updateCurrent",
        "providerEnablement",
        "supportedField",
        "unsupportedField",
        "exactMatch",
        "fuzzyMatch",
        "fullSearch",
        "axDenied",
        "axGranted",
        "lock",
        "reprompt",
        "accountSwitch",
        "logout",
        "appRestart",
        "agentRestart",
        "offline",
        "staleGeneration"
      ],
      "properties": {
        "freshInstallCurrent": { "$ref": "#/$defs/fixedCode" },
        "updateCurrent": { "$ref": "#/$defs/fixedCode" },
        "providerEnablement": { "$ref": "#/$defs/fixedCode" },
        "supportedField": { "$ref": "#/$defs/fixedCode" },
        "unsupportedField": { "$ref": "#/$defs/fixedCode" },
        "exactMatch": { "$ref": "#/$defs/fixedCode" },
        "fuzzyMatch": { "$ref": "#/$defs/fixedCode" },
        "fullSearch": { "$ref": "#/$defs/fixedCode" },
        "axDenied": { "$ref": "#/$defs/fixedCode" },
        "axGranted": { "$ref": "#/$defs/fixedCode" },
        "lock": { "$ref": "#/$defs/fixedCode" },
        "reprompt": { "$ref": "#/$defs/fixedCode" },
        "accountSwitch": { "$ref": "#/$defs/fixedCode" },
        "logout": { "$ref": "#/$defs/fixedCode" },
        "appRestart": { "$ref": "#/$defs/fixedCode" },
        "agentRestart": { "$ref": "#/$defs/fixedCode" },
        "offline": { "$ref": "#/$defs/fixedCode" },
        "staleGeneration": { "$ref": "#/$defs/fixedCode" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PASS" } }, "required": ["status"] },
      "then": {
        "properties": {
          "artifactHashes": {
            "properties": {
              "appSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "dmgSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "productionPromoted": { "const": true },
          "codes": {
            "minItems": 3,
            "maxItems": 3,
            "prefixItems": [
              { "const": "NATIVE_AUTOFILL_RELEASE_VERIFIER_PASS" },
              { "const": "NATIVE_AUTOFILL_CURRENT_LIVE_MATRIX_PASS" },
              { "const": "NATIVE_AUTOFILL_PRODUCTION_PROMOTED" }
            ],
            "items": false
          },
          "liveMatrix": {
            "patternProperties": { ".*": { "const": "NATIVE_AUTOFILL_LIVE_PASS" } }
          }
        }
      }
    }
  ],
  "$defs": {
    "fixedCode": {
      "enum": [
        "NATIVE_AUTOFILL_TOOLING_IMPLEMENTED",
        "NATIVE_AUTOFILL_SIGNING_IDENTITY_MISSING",
        "NATIVE_AUTOFILL_SIGNING_KEYCHAIN_MISSING",
        "NATIVE_AUTOFILL_PRIVATE_KEY_IMPORT_NOT_AUTHORIZED",
        "NATIVE_AUTOFILL_PROVIDER_PROFILE_MISSING",
        "NATIVE_AUTOFILL_XCODE_AUTOMATIC_PROVISIONING_NOT_AUTHORIZED",
        "NATIVE_AUTOFILL_NOTARY_PROFILE_MISSING",
        "NATIVE_AUTOFILL_NOTARY_KEYCHAIN_MISSING",
        "NATIVE_AUTOFILL_NOTARY_ISSUER_ID_MISSING",
        "NATIVE_AUTOFILL_SIGNED_ARTIFACT_MISSING",
        "NATIVE_AUTOFILL_CURRENT_GUI_SESSION_BLOCKED_LOGINWINDOW",
        "NATIVE_AUTOFILL_PRODUCTION_NOT_PROMOTED",
        "NATIVE_AUTOFILL_RELEASE_VERIFIER_PASS",
        "NATIVE_AUTOFILL_CURRENT_LIVE_MATRIX_PASS",
        "NATIVE_AUTOFILL_TEMP_KEYCHAIN_IDENTITY_PASS",
        "NATIVE_AUTOFILL_LOWER_OS_RUNTIME_UNVERIFIED",
        "NATIVE_AUTOFILL_PRODUCTION_PROMOTED",
        "NATIVE_AUTOFILL_LIVE_MATRIX_PENDING",
        "NATIVE_AUTOFILL_LIVE_BLOCKED_NO_RELEASE_ARTIFACT",
        "NATIVE_AUTOFILL_LIVE_PASS"
      ]
    }
  }
}
