{
  "name": "barwarden",
  "version": "0.1.0",
  "description": "A native macOS menu bar client for Bitwarden-compatible vaults.",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare:sdk-runtime": "node scripts/prepare-retained-sdk-wasm.mjs",
    "dev:web": "npm run prepare:sdk-runtime && vite --config apps/menubar-tauri/vite.config.ts --host 127.0.0.1",
    "build:web": "npm run prepare:sdk-runtime && node scripts/build-web-with-warning-baseline.mjs",
    "audit:production-bundle": "scripts/verify-production-bundle.sh",
    "test:audit-production-bundle": "scripts/verify-production-bundle.test.sh",
    "test:macos-bundle": "scripts/verify-macos-bundle.test.sh",
    "verify:macos-bundle": "scripts/verify-macos-bundle.sh",
    "release:macos-bundle": "scripts/verify-macos-bundle.sh --release",
    "verify:m10": "node scripts/run-m10-verification.mjs",
    "verify:m11": "node scripts/run-m11-verification.mjs",
    "verify:m12": "node scripts/run-m12-verification.mjs",
    "verify:m13": "node scripts/run-m13-verification.mjs",
    "check:official-client-convergence": "node scripts/check-official-client-convergence.mjs",
    "test:live:m14:contract": "npx vitest run apps/menubar-tauri/e2e/live/live-test-protocol.spec.ts apps/menubar-tauri/e2e/live/live-auth-contract.spec.ts apps/menubar-tauri/e2e/live/live-vault-scenarios.spec.ts apps/menubar-tauri/e2e/live/live-text-send-scenarios.spec.ts",
    "test:live:m14": "npx playwright test apps/menubar-tauri/e2e/live/live-auth-matrix.spec.ts apps/menubar-tauri/e2e/live/live-vault-matrix.spec.ts apps/menubar-tauri/e2e/live/live-text-send-matrix.spec.ts --project=chromium --workers=1 --reporter=line",
    "test:playwright:release": "UPDATE_EVIDENCE=false playwright test --reporter=./scripts/m14-safe-playwright-reporter.mjs",
    "typecheck:m14": "npm run typecheck:m13 && npm run check:official-client-convergence",
    "verify:m14": "node scripts/run-m14-verification.mjs",
    "test:verify:m16": "node --test scripts/run-m16-verification.spec.mjs",
    "verify:m16": "node scripts/run-m16-verification.mjs",
    "typecheck:official-components": "tsc -p apps/menubar-tauri/tsconfig.official-components.json --pretty false",
    "typecheck:official-login": "tsc -p apps/menubar-tauri/tsconfig.official-login.json --pretty false",
    "typecheck:official-recovery": "tsc -p apps/menubar-tauri/tsconfig.official-recovery.json --pretty false",
    "typecheck:official-generator:local": "tsc -p apps/menubar-tauri/tsconfig.official-generator.json --pretty false",
    "check:official-generator:upstream": "tsc -p apps/menubar-tauri/tsconfig.official-generator-upstream.json --pretty false && node scripts/check-official-generator-upstream.mjs",
    "typecheck:official-generator": "npm run check:official-generator:upstream && npm run typecheck:official-generator:local && npm run build:web",
    "check:official-send:upstream": "node scripts/check-official-send-upstream.mjs",
    "check:official-settings:upstream": "node scripts/check-official-settings-upstream.mjs",
    "check:official-settings:runtime": "node scripts/check-official-settings-runtime.mjs",
    "typecheck:official-send:upstream": "tsc -p apps/menubar-tauri/tsconfig.official-send-upstream.json --pretty false",
    "typecheck:official-send:local": "tsc -p apps/menubar-tauri/tsconfig.official-send.json --pretty false",
    "typecheck:official-send": "npm run check:official-send:upstream && npm run typecheck:official-send:upstream && npm run typecheck:official-send:local && npm run build:web",
    "typecheck:official-settings:upstream": "tsc -p apps/menubar-tauri/tsconfig.official-settings-upstream.json --pretty false",
    "typecheck:official-settings:local": "node scripts/run-official-settings-local-typecheck.mjs",
    "typecheck:official-settings": "npm run check:official-settings:upstream && npm run check:official-settings:runtime && npm run typecheck:official-settings:upstream && npm run typecheck:official-settings:local",
    "typecheck:m12": "npm run typecheck:official-components && npm run typecheck:official-login && npm run typecheck:official-recovery && npm run check:official-generator:upstream && npm run typecheck:official-generator:local && npm run typecheck:official-personal && npm run typecheck:official-send:upstream && npm run typecheck:official-send:local",
    "typecheck:m13": "npm run typecheck:m12 && npm run typecheck:official-settings",
    "update:official-generator-manifest": "node scripts/update-official-generator-manifest.mjs",
    "update:official-send-manifest": "node scripts/update-official-send-manifest.mjs",
    "update:i18n-retained-manifests": "node scripts/update-i18n-retained-manifests.mjs",
    "update:official-settings-manifest": "node scripts/update-official-settings-manifest.mjs",
    "update:official-settings-runtime-manifest": "node scripts/update-official-settings-runtime-manifest.mjs",
    "typecheck:official-personal": "tsc -p apps/menubar-tauri/tsconfig.official-personal.json --pretty false",
    "test": "vitest run",
    "test:brand": "node --test scripts/barwarden-brand.spec.mjs",
    "check:publication": "node scripts/check-publication-readiness.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "test:release-policy": "node --test scripts/audit-release-workflow.spec.mjs && node scripts/audit-release-workflow.mjs",
    "build:icons": "scripts/build-barwarden-icons.sh",
    "test:icons": "scripts/build-barwarden-icons.test.sh && scripts/build-barwarden-icons.inventory.test.sh && scripts/build-barwarden-icons.transaction.test.sh",
    "test:watch": "vitest",
    "tauri:dev": "tauri dev --config apps/menubar-tauri/src-tauri/tauri.conf.json",
    "tauri:build": "tauri build --config apps/menubar-tauri/src-tauri/tauri.conf.json",
    "tauri:build:update": "node scripts/create-updater-release-config.mjs"
  },
  "dependencies": {
    "@angular/animations": "21.2.17",
    "@angular/cdk": "21.2.9",
    "@angular/common": "21.2.17",
    "@angular/compiler": "21.2.17",
    "@angular/core": "21.2.17",
    "@angular/forms": "21.2.17",
    "@angular/platform-browser": "21.2.17",
    "@angular/router": "21.2.17",
    "@bitwarden/sdk-internal": "0.2.0-main.883",
    "@ng-select/ng-select": "21.8.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "buffer": "6.0.3",
    "core-js": "3.49.0",
    "rxjs": "7.8.2",
    "tldts": "7.4.9",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@angular-devkit/build-angular": "21.2.9",
    "@angular/build": "21.2.9",
    "@angular/compiler-cli": "21.2.17",
    "@playwright/test": "1.54.2",
    "@tailwindcss/container-queries": "0.1.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.19.17",
    "autoprefixer": "10.4.22",
    "binaryen": "131.0.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.10",
    "tailwindcss": "3.4.18",
    "type-fest": "2.19.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
